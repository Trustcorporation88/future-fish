# LLM API配置（支持 OpenAI SDK 格式的任意 LLM API）
# DeepSeek (produção seligaaqui):
LLM_API_KEY=your_deepseek_api_key_here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_NAME=deepseek-chat
#
# Alternativa Alibaba Qwen: https://bailian.console.aliyun.com/
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL_NAME=qwen-plus

# ===== ZEP记忆图谱配置 =====
# 每月免费额度即可支撑简单使用：https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== Railway / produção (future.seligaaqui.online) =====
# FLASK_DEBUG=False
# REQUIRE_CONFIG=true   # opcional: não sobe sem LLM+ZEP
# PORT é definido pelo Railway automaticamente

# ===== Supabase Storage (persistência entre deploys) =====
# O filesystem do Railway é efêmero: cada redeploy apaga backend/uploads/ e com
# ele o histórico e os relatórios já entregues. Com as duas variáveis abaixo, os
# artefatos finalizados são espelhados no Storage e voltam ao disco sob demanda.
# Sem elas, tudo continua só em disco local (comportamento padrão).
#
# Use um bucket PRIVADO e a chave service_role - os relatórios ficam atrás do
# login VIP, e um bucket público exporia todos eles por URL.
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_SERVICE_KEY=service_role_key_aqui
# SUPABASE_BUCKET=mirofish

# ===== Acesso VIP (login obrigatório) =====
# Ativa automaticamente se houver credenciais admin ou cliente abaixo.
# VIP_AUTH_ENABLED=true
# JWT_SECRET=gerar_string_longa_aleatoria   # OBRIGATÓRIO com VIP ativo - o app recusa subir sem isso
# VIP_JWT_HOURS=168
#
# Admin (você):
# VIP_ADMIN_USERNAME=admin
# VIP_ADMIN_PASSWORD=trocar_senha_forte
#
# Cliente VIP (um par):
# VIP_CLIENT_USERNAME=cliente
# VIP_CLIENT_PASSWORD=trocar_senha_forte
#
# Clientes extras (opcional): user1:senha1,user2:senha2
# VIP_CLIENT_USERS=

# ===== 加速 LLM 配置（可选）=====
# 注意如果不使用加速配置，env文件中就不要出现下面的配置项
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here

# ===== 后端服务配置（可选，均有默认值）=====
# 监听地址。默认 127.0.0.1，只接受本机连接。
# 后端接口没有身份验证，改成 0.0.0.0 会让同网络的任何人都能调用。
# Docker 镜像内已自动设为 0.0.0.0（容器必须如此才能被宿主机访问）。
# FLASK_HOST=127.0.0.1
# FLASK_PORT=5001

# 调试模式。务必保持 false：开启后 Werkzeug 会提供可执行代码的交互式控制台。
# 若同时设为 true 且监听非本机地址，服务会拒绝启动。
# FLASK_DEBUG=false

# 允许跨域访问的前端地址，多个用逗号分隔。
# 默认只允许本机前端；部署到域名后需在此填写实际地址。
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 会话签名密钥。留空则每次启动随机生成（进程重启后签名失效）。
# 多实例部署或需要重启后保持有效时，请填入一个固定的随机长字符串。
# SECRET_KEY=